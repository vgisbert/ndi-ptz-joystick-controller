{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "NDI-PTZ-Controller",
  "version": "1.0.0",
  "identifier": "com.antigravity.ndi-ptz-controller",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Controlador PTZ NDI",
        "url": "index.html",
        "width": 360,
        "height": 330,
        "minWidth": 340,
        "minHeight": 280,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "visible": true,
        "center": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
