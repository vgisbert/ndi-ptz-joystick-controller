# =======================================================
# NDI PTZ Joystick Controller - .gitignore
# =======================================================

# Compilación y artefactos de Rust / Cargo
/target/
**/target/
src-tauri/target/
*.rs.bk
*.pdb

# Distribuciones compiladas y paquetes binarios
dist_portable/
dist/
build/
bundle/
*.exe
*.dll
*.so
*.dylib
*.msi
*.zip
*.7z
*.tar.gz

# Archivos generados por Tauri
src-tauri/gen/schemas/
window_states.json
**/window_states.json

# Copias de seguridad locales y directorios temporales
backups/
instaladores_ndi/
*.bak
*.backup
*.tmp
*.log

# Dependencias Node / Frontend
node_modules/
.npm/
.pnpm-store/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ficheros de entorno, credenciales y secretos
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# Configuraciones de IDE y editores
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Archivos del sistema operativo
Thumbs.db
Desktop.ini
.DS_Store
ehthumbs.db
[Nn]et[Hh]ood
[Pp]rint[Hh]ood
